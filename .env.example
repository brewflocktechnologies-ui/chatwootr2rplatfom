# Copy to .env (git-ignored). Placeholders only: NO real secrets belong in this file.
# Ports (host side, loopback only)
CHATWOOT_PORT=3100
R2R_PORT=7272
OLLAMA_PORT=11434
PLATFORM_API_PORT=8080
ADMIN_WEB_PORT=4300
# Chatwoot (managed-local profile infra/chatwoot). Real values live in infra/chatwoot/.env.secrets (git-ignored).
CHATWOOT_BASE_URL=http://host.docker.internal:3100
CHATWOOT_ACCOUNT_ID=4
CHATWOOT_INBOX_ID=1
CHATWOOT_TEAM_ID=1
# Tenant seed
TENANT_KEY=acme-demo
# R2R (managed-local profile infra/r2r). Real values live in infra/r2r/.env (git-ignored).
R2R_BASE_URL=http://host.docker.internal:7272
# Local model runtime
OLLAMA_BASE_URL=http://host.docker.internal:11434
