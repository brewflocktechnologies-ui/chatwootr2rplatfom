# Copy to apps/admin-web/.env.local (git-ignored). Placeholders only: no real secret belongs in this file.
# Server-only values. Never prefix these with NEXT_PUBLIC_.

# Platform API base URL as seen from the Next.js server process (default http://127.0.0.1:8080).
PLATFORM_API_URL=http://127.0.0.1:8080

# Admin key for /api/admin/* on the platform. Use >= 32 random characters.
# Replace the placeholder with the value from the ignored root .env (PLATFORM_ADMIN_API_KEY).
PLATFORM_ADMIN_API_KEY=replace-with-the-local-admin-key-from-root-env

# Public origin of this admin console for cross-site write checks (optional).
# http://localhost:4300 and http://127.0.0.1:4300 are always accepted.
# ADMIN_WEB_ORIGIN=http://localhost:4300
